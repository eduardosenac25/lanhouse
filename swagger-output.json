    "/sessoes/": {
      "get": {
        "tags": [
          "Sessões"
        ],
        "summary": "Lista as sessões de jogo (mais recentes primeiro)",
        "description": "",
        "parameters": [
          {
            "name": "jogadorId",
            "in": "query",
            "description": "Filtra as sessões de um jogador",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "tags": [
          "Sessões"
        ],
        "summary": "Abre uma sessão de jogo (transação)",
        "description": "Rota de inclusão com transação. Em uma única transação o sistema: (1) valida jogador e estação; (2) confere se a estação está livre; (3) confere se o saldo do jogador cobre horas x valor da hora; (4) grava a sessão com o preço da hora daquele momento; (5) debita o valor do saldo do jogador; (6) marca a estação como ocupada. Se qualquer passo falhar, nada é gravado (rollback).",
        "responses": {
          "201": {
            "description": "Sessão criada. Retorna a sessão, o jogador com o saldo atualizado e a estação ocupada.",
            "content": {
              "application/json": {
                "example": {
                  "sessao": {
                    "id": 12,
                    "jogadorId": 1,
                    "estacaoId": 3,
                    "horas": "2",
                    "preco": "8",
                    "data": "2026-10-16T22:10:00.000Z"
                  },
                  "jogador": {
                    "id": 1,
                    "nome": "Eduardo",
                    "saldo": "34"
                  },
                  "estacao": {
                    "id": 3,
                    "nome": "PC-03",
                    "status": "ocupada"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos, jogador/estação inexistente ou saldo insuficiente.",
            "content": {
              "application/json": {
                "example": {
                  "erro": "Saldo insuficiente. Saldo atual do jogador: R$ 10.00; custo da sessão: R$ 16.00"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "A estação já está ocupada.",
            "content": {
              "application/json": {
                "example": {
                  "erro": "A estação PC-03 está ocupada"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "jogadorId",
                  "estacaoId",
                  "horas"
                ],
                "properties": {
                  "jogadorId": {
                    "type": "integer",
                    "description": "Id do jogador que vai jogar",
                    "example": 1
                  },
                  "estacaoId": {
                    "type": "integer",
                    "description": "Id da estação (precisa estar livre)",
                    "example": 3
                  },
                  "horas": {
                    "type": "number",
                    "description": "Tempo contratado, de 0.5 a 12, em múltiplos de 0.5",
                    "example": 2
                  }
                }
              },
              "example": {
                "jogadorId": 1,
                "estacaoId": 3,
                "horas": 2
              }
            }
          }
        }
      }
    },
